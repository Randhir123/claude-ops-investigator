{
  "mcpServers": {
    "claude-ops-investigator": {
      "command": "python",
      "args": [
        "-m",
        "claude_ops.mcp.server"
      ],
      "env": {
        "PYTHONPATH": "${PWD}/src"
      }
    },
    "jvm-troubleshooter": {
      "command": "python",
      "args": [
        "-m",
        "jvm_troubleshooter.mcp.server"
      ],
      "env": {
        "PYTHONPATH": "${PWD}/mcp-servers/jvm-troubleshooter/src",
        "PROMETHEUS_URL": "http://localhost:9090",
        "JVM_LABEL_KEY": "job"
      }
    }
  }
}
