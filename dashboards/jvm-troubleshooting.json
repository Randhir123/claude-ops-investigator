{
  "uid": "jvm-troubleshooting",
  "title": "JVM troubleshooting (OpenJ9)",
  "description": "Memory vs container limit, heap and pools, GC, threads and churn, CPU, file descriptors, class loading and JVM versions for OpenJ9 JVMs scraped by the Prometheus JMX Exporter. Generated by dashboards/generate_jvm_troubleshooting.py in claude-ops-investigator.",
  "tags": [
    "jvm",
    "openj9",
    "troubleshooting"
  ],
  "timezone": "utc",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "options": [],
        "refresh": 1
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "refresh": 2,
        "sort": 1,
        "query": {
          "query": "label_values(java_lang_Threading_ThreadCount, namespace)",
          "refId": "namespace-query"
        },
        "definition": "label_values(java_lang_Threading_ThreadCount, namespace)",
        "multi": false,
        "includeAll": false,
        "current": {},
        "options": []
      },
      {
        "name": "label_key",
        "label": "Service label",
        "type": "custom",
        "query": "job,app,service",
        "current": {
          "text": "job",
          "value": "job"
        },
        "options": [
          {
            "text": "job",
            "value": "job",
            "selected": true
          },
          {
            "text": "app",
            "value": "app",
            "selected": false
          },
          {
            "text": "service",
            "value": "service",
            "selected": false
          }
        ],
        "description": "Prometheus label that names the service on JMX Exporter series (JVM_LABEL_KEY)."
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "refresh": 2,
        "sort": 1,
        "query": {
          "query": "label_values(java_lang_Threading_ThreadCount{namespace=\"$namespace\"}, $label_key)",
          "refId": "service-query"
        },
        "definition": "label_values(java_lang_Threading_ThreadCount{namespace=\"$namespace\"}, $label_key)",
        "multi": false,
        "includeAll": false,
        "current": {},
        "options": []
      },
      {
        "name": "pod",
        "label": "Pods",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "refresh": 2,
        "sort": 1,
        "query": {
          "query": "label_values(java_lang_Threading_ThreadCount{namespace=\"$namespace\", $label_key=~\"$service\"}, pod)",
          "refId": "pod-query"
        },
        "definition": "label_values(java_lang_Threading_ThreadCount{namespace=\"$namespace\", $label_key=~\"$service\"}, pod)",
        "multi": true,
        "includeAll": true,
        "current": {},
        "options": [],
        "allValue": ".*"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "At a glance",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "id": 2,
      "title": "JVM pods",
      "description": "Pods of this service with JVM metrics right now.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(java_lang_Threading_ThreadCount{namespace=\"$namespace\", $label_key=~\"$service\", pod=~\"$pod\"})",
          "legendFormat": "",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Lowest memory headroom",
      "description": "Smallest gap between a pod's container working set and its memory limit. Near 0 = OOMKilled risk, whatever the heap looks like.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "min(100 * (1 - (max by (namespace, pod, container) (container_memory_working_set_bytes{namespace=\"$namespace\", container!=\"\", container!=\"POD\"}) and on (namespace, pod, container) max by (namespace, pod, container) (java_lang_Threading_ThreadCount{namespace=\"$namespace\", $label_key=~\"$service\", pod=~\"$pod\"})) / (max by (namespace, pod, container) (kube_pod_container_resource_limits{namespace=\"$namespace\", resource=\"memory\"}) and on (namespace, pod, container) max by (namespace, pod, container) (java_lang_Threading_ThreadCount{namespace=\"$namespace\", $label_key=~\"$service\", pod=~\"$pod\"}))))",
          "legendFormat": "",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "green",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Highest heap used",
      "description": "Highest heap used / heap max across pods. Heap max is -Xmx, not the container limit.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(100 * max by (pod) (java_lang_Memory_HeapMemoryUsage_used{namespace=\"$namespace\", $label_key=~\"$service\", pod=~\"$pod\"}) / max by (pod) (java_lang_Memory_HeapMemoryUsage_max{namespace=\"$namespace\", $label_key=~\"$service\", pod=~\"$pod\"}))",
          "legendFormat": "",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "id": 5,
      "title": "Highest GC overhead (5m)",
      "description": "Share of time in GC on the busiest pod, over 5 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(sum by (pod) (rate(java_lang_GarbageCollector_CollectionTime{namespace=\"$namespace\", $label_key=~\"$service\", pod=~\"$pod\"}[5m])) / 10)",
          "legendFormat": "",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "id": 6,
      "title": "Threads started / s (avg pod)",
      "description": "Thread creation rate per pod. A high rate with a flat thread count is churn: pool threads expiring and being recreated.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg(sum by (pod) (rate(java_lang_Threading_TotalStartedThreadCount{namespace=\"$namespace\", $label_key=~\"$service\", pod=~\"$pod\"}[5m])))",
          "legendFormat": "",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "id": 7,
      "title": "Deadlocked threads",
      "description": "From the JVM's own deadlock detection at scrape time. 0 does not rule out livelock or threads stuck on I/O.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(jvm_threads_deadlocked{namespace=\"$namespace\", $label_key=~\"$service\", pod=~\"$pod\"})",
          "legendFormat": "",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "id": 8,
      "title": "Memory: container limit, heap, pools",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      }
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "Container memory vs limit",
      "description": "Working set is what the kubelet and the OOM killer act on. Dashed = the container memory limit.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (namespace, pod, container) (container_memory_working_set_bytes{namespace=\"$namespace\", container!=\"\", container!=\"POD\"}) and on (namespace, pod, container) max by (namespace, pod, container) (java_lang_Threading_ThreadCount{namespace=\"$namespace\", $label_key=~\"$service\", pod=~\"$pod\"})",
          "legendFormat": "{{pod}} working set",
          "refId": "A",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (namespace, pod, container) (kube_pod_container_resource_limits{namespace=\"$namespace\", resource=\"memory\"}) and on (namespace, pod, container) max by (namespace, pod, container) (java_lang_Threading_ThreadCount{namespace=\"$namespace\", $label_key=~\"$service\", pod=~\"$pod\"})",
          "legendFormat": "{{pod}} limit",
          "refId": "B",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* limit"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "Memory headroom below the limit",
      "description": "100% minus working set / limit. Under 10% means the pod is close to being OOMKilled.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * (1 - (max by (namespace, pod, container) (container_memory_working_set_bytes{namespace=\"$namespace\", container!=\"\", container!=\"POD\"}) and on (namespace, pod, container) max by (namespace, pod, container) (java_lang_Threading_ThreadCount{namespace=\"$namespace\", $label_key=~\"$service\", pod=~\"$pod\"})) / (max by (namespace, pod, container) (kube_pod_container_resource_limits{namespace=\"$namespace\", resource=\"memory\"}) and on (namespace, pod, container) max by (namespace, pod, container) (java_lang_Threading_ThreadCount{namespace=\"$namespace\", $label_key=~\"$service\", pod=~\"$pod\"})))",
          "legendFormat": "{{pod}}",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "green",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "Heap used vs max",
      "description": "A sawtooth that returns to the same floor after GC is normal; a floor that keeps rising suggests a leak. Heap max is -Xmx, not the container limit.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (pod) (java_lang_Memory_HeapMemoryUsage_used{namespace=\"$namespace\", $label_key=~\"$service\", pod=~\"$pod\"})",
          "legendFormat": "{{pod}} used",
          "refId": "A",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(java_lang_Memory_HeapMemoryUsage_max{namespace=\"$namespace\", $label_key=~\"$service\", pod=~\"$pod\"})",
          "legendFormat": "heap max",
          "refId": "B",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "heap max"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "id": 12,
      "title": "Tenured (old gen) after GC: the leak signal",
      "description": "Old-gen usage right after the last collection, i.e. what survived GC. Flat or falling = healthy; steadily rising over hours = objects are being retained (leak candidate). Use a long time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pod) (java_lang_MemoryPool_CollectionUsage_used{namespace=\"$namespace\", $label_key=~\"$service\", pod=~\"$pod\", name=~\"tenured-SOA|tenured-LOA\"})",
          "legendFormat": "{{pod}}",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 13,
      "title": "Memory pools (average per pod)",
      "description": "OpenJ9 pools: nursery (young gen), tenured SOA/LOA (old gen), JIT code/data cache, class storage and other non-heap storage.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg by (name) (java_lang_MemoryPool_Usage_used{namespace=\"$namespace\", $label_key=~\"$service\", pod=~\"$pod\"})",
          "legendFormat": "{{name}}",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 14,
      "title": "Non-heap and direct buffers",
      "description": "Memory outside the heap that still counts against the container limit. Growing direct buffers often come from network I/O (Netty, NIO).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (pod) (java_lang_Memory_NonHeapMemoryUsage_used{namespace=\"$namespace\", $label_key=~\"$service\", pod=~\"$pod\"})",
          "legendFormat": "{{pod}} non-heap",
          "refId": "A",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (pod) (jvm_buffer_pool_used_bytes{namespace=\"$namespace\", $label_key=~\"$service\", pod=~\"$pod\", pool=\"direct\"})",
          "legendFormat": "{{pod}} direct buffers",
          "refId": "B",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "id": 15,
      "title": "Garbage collection",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 30
      }
    },
    {
      "type": "timeseries",
      "id": 16,
      "title": "GC overhead per pod",
      "description": "Share of wall time spent in GC (all collectors), 5-minute rate. Sustained above ~5-10% means GC is costing throughput.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pod) (rate(java_lang_GarbageCollector_CollectionTime{namespace=\"$namespace\", $label_key=~\"$service\", pod=~\"$pod\"}[5m])) / 10",
          "legendFormat": "{{pod}}",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 17,
      "title": "GC collections per minute",
      "description": "scavenge = young-gen collections (frequent, cheap); global = old-gen collections (rare, expensive).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pod, name) (rate(java_lang_GarbageCollector_CollectionCount{namespace=\"$namespace\", $label_key=~\"$service\", pod=~\"$pod\"}[5m])) * 60",
          "legendFormat": "{{pod}} {{name}}",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 18,
      "title": "Average GC pause by collector",
      "description": "Mean pause per collection over 5 minutes. Averages hide the worst pauses: for real per-pause max/p99 use the GC log (jvm_get_gc_log_events / jvm_analyze_gc_log). A gap = no collections of that type in the 5-minute window.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 39
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (name) (rate(java_lang_GarbageCollector_CollectionTime{namespace=\"$namespace\", $label_key=~\"$service\", pod=~\"$pod\"}[5m])) / (sum by (name) (rate(java_lang_GarbageCollector_CollectionCount{namespace=\"$namespace\", $label_key=~\"$service\", pod=~\"$pod\"}[5m])) > 0)",
          "legendFormat": "{{name}}",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 19,
      "title": "Heap used vs GC frequency (leak or load?)",
      "description": "Heap that returns to baseline while GC rises and falls = load. A rising heap floor together with climbing GC frequency = leak or undersized heap.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 39
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg(java_lang_Memory_HeapMemoryUsage_used{namespace=\"$namespace\", $label_key=~\"$service\", pod=~\"$pod\"})",
          "legendFormat": "heap used (avg pod)",
          "refId": "A",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg(sum by (pod) (rate(java_lang_GarbageCollector_CollectionCount{namespace=\"$namespace\", $label_key=~\"$service\", pod=~\"$pod\"}[5m]))) * 60",
          "legendFormat": "GC per minute (avg pod)",
          "refId": "B",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "GC per minute.*"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      }
    },
    {
      "type": "row",
      "id": 20,
      "title": "Threads",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 47
      }
    },
    {
      "type": "timeseries",
      "id": 21,
      "title": "Live threads",
      "description": "Thread COUNT, not state. A steady climb means threads are piling up.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 48
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (pod) (java_lang_Threading_ThreadCount{namespace=\"$namespace\", $label_key=~\"$service\", pod=~\"$pod\"})",
          "legendFormat": "{{pod}}",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 22,
      "title": "Threads started per second (churn)",
      "description": "Thread creation rate. High with a flat live count = churn (short keep-alive, pools created per task). Which pool churns needs a javacore series (jvm_compare_javacores).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 48
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pod) (rate(java_lang_Threading_TotalStartedThreadCount{namespace=\"$namespace\", $label_key=~\"$service\", pod=~\"$pod\"}[5m]))",
          "legendFormat": "{{pod}}",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 23,
      "title": "Daemon threads",
      "description": "Daemon threads per pod; peak count is in the MCP tool get_thread_trend.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 48
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (pod) (java_lang_Threading_DaemonThreadCount{namespace=\"$namespace\", $label_key=~\"$service\", pod=~\"$pod\"})",
          "legendFormat": "{{pod}}",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "id": 24,
      "title": "CPU, file descriptors, class loading",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 56
      }
    },
    {
      "type": "timeseries",
      "id": 25,
      "title": "Process CPU",
      "description": "CPU in cores (1 = one full core). Dashed = CPU limit, when the container has one; sustained use at the limit means throttling.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 57
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (pod) (rate(process_cpu_seconds_total{namespace=\"$namespace\", $label_key=~\"$service\", pod=~\"$pod\"}[5m]))",
          "legendFormat": "{{pod}}",
          "refId": "A",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (namespace, pod, container) (kube_pod_container_resource_limits{namespace=\"$namespace\", resource=\"cpu\"}) and on (namespace, pod, container) max by (namespace, pod, container) (java_lang_Threading_ThreadCount{namespace=\"$namespace\", $label_key=~\"$service\", pod=~\"$pod\"})",
          "legendFormat": "{{pod}} CPU limit",
          "refId": "B",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* CPU limit"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "id": 26,
      "title": "CPU vs GC overhead",
      "description": "Lines moving together with low GC overhead = load drives both. High GC overhead rising with CPU = GC is driving the CPU.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 57
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg(rate(process_cpu_seconds_total{namespace=\"$namespace\", $label_key=~\"$service\", pod=~\"$pod\"}[5m]))",
          "legendFormat": "CPU cores (avg pod)",
          "refId": "A",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg(sum by (pod) (rate(java_lang_GarbageCollector_CollectionTime{namespace=\"$namespace\", $label_key=~\"$service\", pod=~\"$pod\"}[5m])) / 10)",
          "legendFormat": "GC overhead % (avg pod)",
          "refId": "B",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "GC overhead.*"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "id": 27,
      "title": "Open file descriptors (% of max)",
      "description": "Near 100% causes 'Too many open files'. A steady climb suggests leaked sockets or files.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 65
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * max by (pod) (process_open_fds{namespace=\"$namespace\", $label_key=~\"$service\", pod=~\"$pod\"}) / max by (pod) (process_max_fds{namespace=\"$namespace\", $label_key=~\"$service\", pod=~\"$pod\"})",
          "legendFormat": "{{pod}}",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 28,
      "title": "Classes loaded and unloaded",
      "description": "Loaded classes should flatten after warm-up. A steady climb hours after start, with few unloads, suggests a classloader leak.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 65
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (pod) (java_lang_ClassLoading_LoadedClassCount{namespace=\"$namespace\", $label_key=~\"$service\", pod=~\"$pod\"})",
          "legendFormat": "{{pod}} loaded",
          "refId": "A",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pod) (rate(java_lang_ClassLoading_UnloadedClassCount{namespace=\"$namespace\", $label_key=~\"$service\", pod=~\"$pod\"}[1h])) * 3600",
          "legendFormat": "{{pod}} unloaded / hour",
          "refId": "B",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* unloaded / hour"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      }
    },
    {
      "type": "row",
      "id": 29,
      "title": "Runtime",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 73
      }
    },
    {
      "type": "table",
      "id": 30,
      "title": "JVM version and uptime per pod",
      "description": "Uptime in hours. A pod much younger than the others restarted or was rescheduled; different versions mean pods run different JVM builds.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 74
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (pod, version, vendor, runtime) (jvm_info{namespace=\"$namespace\", $label_key=~\"$service\", pod=~\"$pod\"}) * on (pod) group_left() (max by (pod) (java_lang_Runtime_Uptime{namespace=\"$namespace\", $label_key=~\"$service\", pod=~\"$pod\"}) / 3600000)",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": false
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "uptime (hours)",
              "pod": "pod",
              "version": "JVM version",
              "vendor": "vendor",
              "runtime": "runtime"
            }
          }
        }
      ]
    }
  ]
}
