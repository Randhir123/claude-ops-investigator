# Base URL of the Prometheus (or Thanos Query) server that scrapes your
# OpenJ9 JVM's JMX Exporter metrics.
PROMETHEUS_URL=http://your-prometheus:9090

# The Prometheus label that identifies which service/job a metric series
# belongs to (matched against `--service` with a regex like `(event-data)`).
# This varies by scrape config -- common values are "job", "service", or
# "app". Confirm which one your cluster actually uses before relying on
# results; a wrong label_key silently returns "no data", not an error.
JVM_LABEL_KEY=job

# Optional: change the MCP server's own HTTP port if run over HTTP transport.
JVM_MCP_HTTP_PORT=8090
