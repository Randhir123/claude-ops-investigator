{
  "mcpServers": {
    "jvm-troubleshooter": {
      "command": "python",
      "args": [
        "-m",
        "jvm_troubleshooter.mcp.server"
      ],
      "env": {
        "PYTHONPATH": "${PWD}/src",
        "PROMETHEUS_URL": "http://prometheus:9090",
        "JVM_LABEL_KEY": "job"
      }
    }
  }
}
